# Copy to .env (docker-compose.yml reads it automatically) to override
# any of these. Everything here has a working default already baked
# into docker-compose.yml — this file is only for tuning the demo.

# --- api / worker -----------------------------------------------------
LOG_LEVEL=INFO
# Seconds since an asset's last event before /api/v1/assets reads it as
# offline (docs/PLAN.md, D3 — computed at read time, never stored).
ASSET_OFFLINE_TIMEOUT_SECONDS=10

# --- simulator (test equipment, not part of the product) --------------
# Seconds between ticks per asset.
SIM_TICK_INTERVAL_SECONDS=1.0
# Fixed seed for a reproducible run; blank picks a random one each start.
SIM_SEED=
# Each is a 0.0-1.0 probability applied independently per tick; 0 turns
# a switch off. Defaults in docker-compose.yml are non-zero so a plain
# `docker compose up` shows every failure path immediately — set these
# to 0 here for a clean, uneventful fleet instead.
SIM_DUPLICATE_RATE=0.1
SIM_OUT_OF_ORDER_RATE=0.1
SIM_BAD_DATA_RATE=0.1
SIM_SILENCE_RATE=0.05
# Comma-separated asset ids that never send at all, regardless of
# SIM_SILENCE_RATE — a deliberate, noise-free way to demo the offline
# timeout. Example: SIM_FORCE_SILENT_ASSET_IDS=rover-01
SIM_FORCE_SILENT_ASSET_IDS=
